{
  "permissions": {
    "allow": [
      "WebFetch(domain:github.com)",
      "Bash(docker build:*)",
      "Bash(docker rm:*)",
      "Bash(docker exec:*)",
      "Bash(docker run:*)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8080)",
      "Bash(curl -s -o /dev/null -w \"%{http_code}\" http://localhost:8080/phpinfo)",
      "Bash(curl -s http://localhost:8080/phpinfo | grep -o 'PHP Version [0-9.]*' | head -1)"
    ]
  }
}
